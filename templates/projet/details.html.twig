{% extends 'base.html.twig' %}

{% block title %}Détails du projet {{ projet.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="w-full px-4 py-8">
        {# En-tête du projet #}
        <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
            <div class="bg-blue-600 px-6 py-4">
                <h1 class="text-xl md:text-2xl font-bold text-white flex items-center">
                    <i class="fas fa-project-diagram mr-3"></i>
                    {{ projet.acronyme }} - {{ projet.titre }}
                </h1>
            </div>
            
            {# Bordereau d'informations #}
            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Colonne 1 - Informations principales #}
                    <div class="space-y-4">
                        <div class="border-b pb-2">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Informations principales</h2>
                            
                            <div class="grid grid-cols-1 gap-3">
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Numéro du projet :</span>
                                    </div>
                                    <div class="flex-grow">
                                        <span class="text-gray-800">{{ projet.id }}</span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Acronyme :</span>
                                    </div>
                                    <div class="flex-grow">
                                        <span class="text-gray-800">{{ projet.acronyme }}</span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Titre complet :</span>
                                    </div>
                                    <div class="flex-grow">
                                        <span class="text-gray-800">{{ projet.titre }}</span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Statut :</span>
                                    </div>
                                    <div class="flex-grow">
                                        <span class="px-2 py-1 text-sm rounded-full bg-yellow-100 text-yellow-800">En soumission</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {# Colonne 2 - Équipe du projet #}
                    <div class="space-y-4">
                        <div class="border-b pb-2">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Équipe du projet</h2>
                            
                            <div class="grid grid-cols-1 gap-3">
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Responsable méthodo:</span>
                                    </div>
                                    <div class="flex-grow flex items-center">
                                        <i class="fas fa-user-tie text-blue-500 mr-2"></i>
                                        <span class="text-gray-800">Axelle Dupont</span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Chef de projet :</span>
                                    </div>
                                    <div class="flex-grow flex items-center">
                                        <i class="fas fa-user-cog text-green-500 mr-2"></i>
                                        <span class="text-gray-800">Annabelle Metois</span>
                                    </div>
                                </div>
                                
                                <div class="flex items-start">
                                    <div class="w-40 flex-shrink-0">
                                        <span class="text-gray-600 font-medium">Biostat référent :</span>
                                    </div>
                                    <div class="flex-grow flex items-center">
                                        <i class="fas fa-chart-line text-purple-500 mr-2"></i>
                                        <span class="text-gray-800">Najeh Dabbek</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        {# Section Description avec nouveau design #}
          

    <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-6">
    <div class="bg-blue-600 px-6 py-4">
        <h1 class="text-xl md:text-2xl font-bold text-white flex items-center">
            <i class="fas fa-clipboard-list mr-3"></i>
            Description du projet
        </h1>
    </div>
    <div class="p-6 overflow-y-auto"> <!-- Ajoutez overflow-y-auto ici -->
        {{ include('description/index.html.twig', {
            'item': item,
            'questions': questions,
            'projet': projet
        }) }}
    </div>
</div>




        
       





{% endblock %}