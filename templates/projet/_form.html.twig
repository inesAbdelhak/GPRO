{{ form_start(form, {'attr': {'id': 'newProjetForm', 'class': 'space-y-4'}}) }}
    {# Afficher les erreurs globales du formulaire #}
    {% if form.vars.errors|length > 0 %}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
            <p class="font-bold">Erreur de validation</p>
            <ul>
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="mb-4">
        {{ form_label(form.Acronyme, 'Acronyme', {'label_attr': {'class': 'block text-gray-700'}}) }}
        {{ form_widget(form.Acronyme, {'attr': {'class': 'w-full px-3 py-2 border rounded'}}) }}
        {% if form.Acronyme.vars.errors|length > 0 %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mt-2" role="alert">
                {% for error in form.Acronyme.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>
  
    <div class="mb-4">
        {{ form_label(form.Titre, 'Titre', {'label_attr': {'class': 'block text-gray-700'}}) }}
        {{ form_widget(form.Titre, {'attr': {'class': 'w-full px-3 py-2 border rounded'}}) }}
        {% if form.Titre.vars.errors|length > 0 %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mt-2" role="alert">
                {% for error in form.Titre.vars.errors %}
                    <p>{{ error.message }}</p>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    
    <div class="flex justify-between">
        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">
            Créer
        </button>
        <button type="button" id="closeProjetModal" class="bg-gray-500 text-white px-4 py-2 rounded">
            Annuler
        </button>
    </div>
{{ form_end(form) }}