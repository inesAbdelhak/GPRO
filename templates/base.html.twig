<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Tableau de bord - GPRO{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <style>
            body.sidebar-expanded main.content-main {
                margin-left: 250px;
            }
            body.sidebar-collapsed main.content-main {
                margin-left: 80px;
            }
            main.content-main {
                transition: margin-left 0.3s ease-in-out;
            }
        </style>
    {% endblock %}
</head>
<body class="h-full sidebar-expanded">
    <div id="react-dashboard">
        <div id="sidebar-container"></div>
        <div id="header-container"></div>
        <main class="pt-16 content-main w-full" style="min-height: 100vh; overflow-y: auto;">
            {% block body %}{% endblock %}
        </main>
    </div>
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
        {{ encore_entry_script_tags('dashboard_layout') }}
    {% endblock %}
</body> 
</html>