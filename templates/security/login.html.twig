{% extends 'login_base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="min-h-screen flex items-center justify-center bg-cover bg-no-repeat" style="background-image: url('{{ asset('images/fond.png') }}')">

  <div class="max-w-xl mx-auto">

    <!-- Logo -->
    <div class="flex justify-center mb-6">
      <img src="{{ asset('images/logo.png') }}" alt="logo" class="w-auto h-auto max-w-full mx-auto sm:w-48 md:w-64 lg:w-40">
    </div>
{% if error %}

    <div class="bg-custom-alert text-white p-4 rounded">

        {{ 'Vos identifiants semblent incorrects'|trans({}, 'security') }}

    </div>

{% endif %}

    <!-- Formulaire de connexion -->
      <form class="bg-white shadow-md rounded px-8 pt-10 pb-8 mb-4 mx-auto w-full sm:max-w-md shadow-lg" action="" method="post">
    
      <div class="mb-6 flex justify-center">
        <span class="text-lg text-gray-700"> Connectez-vous à votre compte</span>
      </div>
      <div class="mb-6">
        <label class="block text-gray-700 text-sm font-bold mb-2" for="NomUtilisateur"><i class="fas fa-user mr-2"></i> Nom d'utilisateur </label>
        <input type="text" name="_username" id="username" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" placeholder="Nom d'utilisateur">      </div>
      <div class="mb-6">
        <label class="block text-gray-700 text-sm font-bold mb-2" for="MotDePasse"><i class="fas fa-lock mr-2"></i> Mot de passe </label>
        <input type="password" name="_password" id="password" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" placeholder="Mot de passe">      </div>
      <div class="mb-6 flex justify-center">
        <button type="submit" class="bg-custom-color bg-custom-hover text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition-colors duration-300 mt-5">Connexion</button>
      </div>
      
    </form>
  </div>
</div>
{% endblock %}
 