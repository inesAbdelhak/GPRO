{% extends 'base.html.twig' %}

{% block title %}GPRO{% endblock %}

{% block body %}
    {% if defaultContent is defined %}
        {{ defaultContent|raw }}
    {% endif %}
  
    <script>
        // Liste des fonctions à exécuter après le chargement du contenu
        window.initPageContent = [];
        
        document.querySelectorAll('.load-content').forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                var url = this.getAttribute('href');
                var target = this.getAttribute('data-target');
                
                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        document.querySelector(target).innerHTML = html;
                        // Exécute toutes les fonctions d'initialisation
                        window.initPageContent.forEach(fn => fn());
                    })
                    .catch(error => console.error('Erreur lors du chargement du contenu :', error));
            });
        });
    </script>
{% endblock %}